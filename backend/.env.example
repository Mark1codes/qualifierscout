# QualifierScout Environment Variables
# Copy this file and rename it to ".env" in the backend folder
# Do not commit the actual .env file to Git!

# Apollo API Key for "Ghost Hunter" enrichment (Contact info, LinkedIn)
APOLLO_API_KEY=your_apollo_key_here

# ZenRows API Key for unblocking heavily protected state portals
ZENROWS_API_KEY=your_zenrows_key_here

# ZeroBounce API Key for email deliverability verification
ZEROBOUNCE_API_KEY=your_zerobounce_key_here
